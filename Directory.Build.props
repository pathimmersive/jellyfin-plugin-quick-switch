<Project>

  <PropertyGroup>
    <!-- The Jellyfin.Controller version the plugin and its tests build against. A plugin built
         against a newer Jellyfin is refused by an older server. Override with -p:JellyfinVersion=<version>. -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.2.0</JellyfinVersion>
    <!-- The .NET analyzers at their recommended rules; each project treats warnings as errors. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

</Project>
