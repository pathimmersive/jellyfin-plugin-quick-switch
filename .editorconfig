root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,csproj,props,slnx,svg,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.cs]
# Members that could be static stay instance members where the class is a
# service other code is given; those places say so with SuppressMessage.
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
